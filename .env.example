# ============================================================================
# first-dotnet development environment variables
# ============================================================================
# Copy this file to .env and edit the values you want to change:
#     cp .env.example .env
#
# These values are consumed by:
#   - docker compose (via `docker compose --env-file .env`)
#   - the frontend Vite dev server via VITE_API_URL
#
# Note: the Makefile also has its own ?= defaults. Docker Compose only
# understands plain KEY=VALUE lines, so do not use ?= or export in this
# file.
# ============================================================================

# --- Application ----------------------------------------------------------------
# Docker Compose project name (also used by make as APP_NAME).
APP_NAME=first-dotnet

# Environment: dev | staging | prod
APP_ENV=dev

# Node environment passed to the frontend container.
NODE_ENV=development

# .NET / Spring profile active in the backend container.
SPRING_PROFILES_ACTIVE=dev

# --- Frontend -------------------------------------------------------------------
# Port the Vite dev server runs on inside the container.
FRONTEND_PORT=5173

# Base URL the frontend uses to call the backend.
# Leave empty so the frontend calls /api/products directly, and nginx proxies
# /api to the backend container (http://api:8080).
VITE_API_URL=

# --- Backend --------------------------------------------------------------------
# Port the .NET ASP.NET Core backend listens on inside the container.
BACKEND_PORT=8080

# Host port mapped to BACKEND_PORT (so you can reach the API at localhost:5080).
HOST_BACKEND_PORT=5080

# ASP.NET Core environment (enables Swagger UI in Development).
ASPNETCORE_ENVIRONMENT=Development

# --- Database -------------------------------------------------------------------
# Database host. In dev this is the "db" service; in prod it points to the
# managed database host. Using "db" makes `docker compose` DNS resolution work.
DB_HOST=db

# Database port inside the container.
DB_PORT=5432

# Host port mapped to DB_PORT (for DBeaver / pgAdmin access from your machine).
HOST_DB_PORT=5432

# Database name.
DB_NAME=firsatdotnet_db

# Database user.
DB_USER=firstdotnet

# Database password.
DB_PASSWORD=myapp_pw

# (Optional) Connection string used by the .NET backend.
# Leave empty to use the one built from DB_HOST/DB_PORT/DB_NAME above.
# CONNECTION_STRING=Host=...;Database=...;User Id=...;Password=...
